{
  "name": "kaizen-html-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Самостоятельный бот KAIZEN с HTML-виджетами внутри сообщений Telegram",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --use-env-proxy --use-system-ca --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --use-env-proxy --use-system-ca --env-file-if-exists=.env server.mjs",
    "bot": "node --use-env-proxy --use-system-ca --env-file-if-exists=.env bot.mjs",
    "build": "node --use-env-proxy --use-system-ca --env-file-if-exists=.env scripts/build.mjs",
    "setup:bot": "node --use-env-proxy --use-system-ca --env-file-if-exists=.env scripts/setup-bot.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python3 tests/browser.py"
  }
}
